using Gtk 4.0;
using Gio 2.0;
using Adw 1;

Adw.Dialog dialog {
  title: "SSH Connection";
  content-width: 400;
  content-height: 500;
  closed => $closed();

  Adw.ToolbarView {
    top-bar-style: flat;

    [top]
    Adw.HeaderBar {
      [title]
      Gtk.SearchEntry search {
        hexpand: true;
        placeholder-text: "Filter or enter user@host…";
        stop-search => $search_stopped();
        activate => $search_activated();

        styles [
          "command-palette-search",
        ]
      }
    }

    Gtk.ScrolledWindow {
      min-content-height: 300;

      Gtk.ListView view {
        single-click-activate: true;
        activate => $row_activated();

        model: Gtk.SingleSelection model {
          model: Gtk.FilterListModel {
            incremental: true;

            filter: Gtk.StringFilter {
              expression: expr item as <$GhosttySshHostEntry>.title;
              search: bind search.text;
            };

            model: Gtk.SortListModel {
              model: Gio.ListStore source {
                item-type: typeof<$GhosttySshHostEntry>;
              };

              sorter: Gtk.StringSorter {
                expression: expr item as <$GhosttySshHostEntry>.title;
              };
            };
          };
        };

        styles [
          "navigation-sidebar",
        ]

        factory: Gtk.BuilderListItemFactory {
          template Gtk.ListItem {
            child: Gtk.Box {
              orientation: horizontal;
              spacing: 12;
              margin-start: 12;
              margin-end: 12;
              margin-top: 8;
              margin-bottom: 8;

              Gtk.Box {
                orientation: vertical;
                valign: center;
                spacing: 2;

                Gtk.Label {
                  halign: start;
                  ellipsize: end;
                  single-line-mode: true;

                  styles [
                    "heading",
                  ]

                  label: bind template.item as <$GhosttySshHostEntry>.title;
                }

                Gtk.Label {
                  halign: start;
                  ellipsize: end;
                  single-line-mode: true;

                  styles [
                    "dim-label",
                    "caption",
                  ]

                  label: bind template.item as <$GhosttySshHostEntry>.subtitle;
                }
              }
            };
          }
        };
      }
    }
  }
}
