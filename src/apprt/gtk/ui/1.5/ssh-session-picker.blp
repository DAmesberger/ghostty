using Gtk 4.0;
using Gio 2.0;
using Adw 1;

Adw.Dialog dialog {
  title: "Sessions";
  content-width: 500;
  content-height: 550;
  closed => $closed();

  Adw.ToolbarView {
    top-bar-style: flat;

    [top]
    Adw.HeaderBar {
      [title]
      Gtk.Label header_label {
        label: "Sessions";

        styles [
          "heading",
        ]
      }

      [end]
      Gtk.Button refresh_button {
        icon-name: "view-refresh-symbolic";
        tooltip-text: "Refresh session list";
        clicked => $refresh_clicked();
      }
    }

    Gtk.Stack stack {
      transition-type: crossfade;

      Gtk.StackPage {
        name: "loading";
        child: Gtk.Box {
          orientation: vertical;
          valign: center;
          halign: center;
          spacing: 12;

          Gtk.Spinner spinner {
            spinning: true;
            width-request: 32;
            height-request: 32;
          }

          Gtk.Label {
            label: "Querying sessions…";

            styles [
              "dim-label",
            ]
          }
        };
      }

      Gtk.StackPage {
        name: "list";
        child: Gtk.Box {
          orientation: vertical;

          Gtk.ScrolledWindow {
            vexpand: true;
            min-content-height: 300;

            Gtk.ListView view {
              activate => $row_activated();

              model: Gtk.SingleSelection model {
                model: Gio.ListStore source {
                  item-type: typeof<$GhosttySshSessionEntry>;
                };
              };

              styles [
                "navigation-sidebar",
              ]

              factory: Gtk.BuilderListItemFactory {
                template Gtk.ListItem {
                  child: Gtk.Box {
                    orientation: horizontal;
                    spacing: 12;
                    margin-start: 12;
                    margin-end: 12;
                    margin-top: 8;
                    margin-bottom: 8;

                    Gtk.Box {
                      orientation: vertical;
                      valign: center;
                      spacing: 2;
                      hexpand: true;

                      Gtk.Label {
                        halign: start;
                        ellipsize: end;
                        single-line-mode: true;

                        styles [
                          "heading",
                        ]

                        label: bind template.item as <$GhosttySshSessionEntry>.title;
                      }

                      Gtk.Label {
                        halign: start;
                        ellipsize: end;
                        single-line-mode: true;

                        styles [
                          "dim-label",
                          "caption",
                        ]

                        label: bind template.item as <$GhosttySshSessionEntry>.subtitle;
                      }
                    }

                    Gtk.Label {
                      valign: center;

                      styles [
                        "dim-label",
                        "caption",
                      ]

                      label: bind template.item as <$GhosttySshSessionEntry>.status;
                    }
                  };
                }
              };
            }
          }

          // Action bar at bottom — acts on the selected session
          Gtk.ActionBar action_bar {
            revealed: false;

            [center]
            Gtk.Box {
              orientation: horizontal;
              spacing: 8;

              Gtk.Button attach_button {
                label: "Attach";
                clicked => $attach_clicked();

                styles [
                  "suggested-action",
                ]
              }

              Gtk.Button rename_button {
                label: "Rename";
                clicked => $rename_clicked();
              }

              Gtk.Button kill_button {
                label: "Kill Session";
                clicked => $kill_clicked();

                styles [
                  "destructive-action",
                ]
              }
            }
          }
        };
      }

      Gtk.StackPage {
        name: "empty";
        child: Gtk.Box {
          orientation: vertical;
          valign: center;
          halign: center;
          spacing: 12;

          Adw.StatusPage {
            icon-name: "network-server-symbolic";
            title: "No Sessions";
            description: "No active sessions on this host. Connect to create one.";
          }
        };
      }

      Gtk.StackPage {
        name: "error";
        child: Gtk.Box {
          orientation: vertical;
          valign: center;
          halign: center;
          spacing: 12;
          margin-start: 24;
          margin-end: 24;

          Gtk.Image {
            icon-name: "dialog-warning-symbolic";
            pixel-size: 48;

            styles [
              "dim-label",
            ]
          }

          Gtk.Label error_label {
            wrap: true;
            justify: center;

            styles [
              "dim-label",
            ]
          }
        };
      }
    }
  }
}
