using Gtk 4.0;
using Adw 1;

template $GhosttyConnectionOverlay: Adw.Bin {
  visible: false;
  halign: center;
  valign: center;
  // Must not capture input by default; only interactive during password prompt.
  can-focus: false;
  can-target: false;
  focusable: false;

  Adw.Bin {
    Box {
      styles [
        "background",
        "connection-overlay",
      ]

      orientation: vertical;
      spacing: 8;
      halign: center;
      valign: center;

      Label status_label {
        styles [
          "connection-status",
        ]

        justify: center;
        selectable: false;
        wrap: true;
        wrap-mode: word_char;
        max-width-chars: 40;
      }

      ProgressBar progress_bar {
        visible: false;
        styles [
          "osd",
        ]
      }

      PasswordEntry password_entry {
        visible: false;
        placeholder-text: "Password";
        activate => $password_activate();
      }

      Box button_box {
        visible: false;
        orientation: horizontal;
        spacing: 8;
        halign: center;

        styles [
          "linked",
        ]

        Button reconnect_button {
          styles ["suggested-action"]
          clicked => $reconnect_button_clicked();
        }

        Button action_button {
          styles ["destructive-action"]
          clicked => $action_button_clicked();
        }
      }
    }
  }
}
